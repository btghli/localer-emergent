# Local development defaults. Never commit real credentials.
MONGO_URL=mongodb://localhost:27017
DB_NAME=localer

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

# Required only for Ask Localer and translation.
EMERGENT_LLM_KEY=

# Optional: enables the Events category.
TICKETMASTER_API_KEY=

# Explicit origins are safer than "*" and support authenticated requests.
CORS_ORIGINS=http://localhost:3000
